      "explanation": "'Aller' uses être: je suis allé(e)."
    },
    {
      "id": "w07_g02",
      "type": "multiple_choice",
      "question": "Which verbs use 'être' in passé composé (not 'avoir')?",
      "options": [
        "manger, boire, voir",
        "aller, venir, partir, arriver",
        "travailler, parler, finir",
        "avoir, être, faire"
