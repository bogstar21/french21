  "grammar": [
    {
      "id": "w06_g01",
      "type": "fill_blank",
      "instruction": "Complete the passé composé with 'avoir'",
      "sentence": "J' ___ travaillé hier.",
      "answer": "ai",
      "hint": "avoir (present) + past participle",
      "explanation": "Passé composé = avoir (conjugated) + past participle: j'ai travaillé."
    },
    {
      "id": "w06_g02",
      "type": "fill_blank",
      "instruction": "Give the past participle of 'faire' (to do/make)",
