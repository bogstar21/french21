  "grammar": [
    {
      "id": "w11_g01",
      "type": "fill_blank",
      "instruction": "Replace 'au client' with an indirect object pronoun",
      "sentence": "Je ___ téléphone.",
      "answer": "lui",
      "hint": "Indirect object, singular",
      "explanation": "'Lui' replaces 'à + person' (singular, masc. or fem.): je lui téléphone."
    },
    {
      "id": "w11_g02",
      "type": "fill_blank",
      "instruction": "Replace 'aux clients' with an indirect object pronoun",
      "sentence": "Je ___ réponds.",
      "answer": "leur",
      "hint": "Indirect object, plural",
      "explanation": "'Leur' replaces 'à + plural people': je leur réponds."
    },
    {
      "id": "w11_g03",
      "type": "multiple_choice",
      "question": "Which is the polite conditional form of 'vouloir' (to want)?",
      "options": [
        "je veux",
        "je voudrais",
        "je voulais",
        "je veuille"
      ],
      "correctIndex": 1,
      "explanation": "'Je voudrais' (conditional) is the polite way to say 'I would like'."
    },
    {
      "id": "w11_g04",
      "type": "multiple_choice",
      "question": "How do you politely ask 'Could you help me?'",
      "options": [
        "Vous pouvez m'aider ?",
        "Pourriez-vous m'aider ?",
        "Vous m'aidez ?",
        "Aidez-moi !"
      ],
      "correctIndex": 1,
      "explanation": "'Pourriez-vous' (conditional of pouvoir) is the polite, formal way to ask."
    },
    {
      "id": "w11_g05",
      "type": "fill_blank",
      "instruction": "Complete with the relative pronoun 'qui' (subject) or 'que' (object)",
      "sentence": "C'est le client ___ a appelé hier.",
      "answer": "qui",
      "hint": "'qui' is the subject of the next verb",
      "explanation": "'Qui' replaces the subject of the relative clause (the client WHO called)."
    },
    {
      "id": "w11_g06",
      "type": "fill_blank",
      "instruction": "Complete with the relative pronoun",
      "sentence": "C'est le problème ___ j'ai résolu.",
