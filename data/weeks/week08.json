  "grammar": [
    {
      "id": "w08_g01",
      "type": "fill_blank",
      "instruction": "Complete the futur proche",
      "sentence": "Je ___ envoyer un email.",
      "answer": "vais",
      "hint": "aller (present) + infinitive",
      "explanation": "Futur proche = aller (conjugated) + infinitive: je vais envoyer."
    },
    {
      "id": "w08_g02",
      "type": "multiple_choice",
      "question": "How do you say 'We are going to organize a meeting'?",
      "options": [
        "Nous allons organiser une réunion",
        "Nous organisons allons une réunion",
        "Nous avons organiser une réunion",
        "Nous allons organisé une réunion"
      ],
      "correctIndex": 0,
      "explanation": "Futur proche: aller + infinitive (unchanged verb)."
    },
    {
      "id": "w08_g03",
      "type": "fill_blank",
      "instruction": "Give the imperative (vous form) of 'envoyer'",
      "sentence": "___ le rapport avant vendredi.",
      "answer": "Envoyez",
      "hint": "Imperative vous form = present tense vous form, no pronoun",
      "explanation": "Imperative vous: drop 'vous', keep the verb form: Envoyez."
    },
